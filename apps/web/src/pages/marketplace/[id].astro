---
import Layout from '../../layouts/Layout.astro';
import CustomModelViewer from '../../components/CustomModelViewer.astro';
import CheckoutModal from '../../components/CheckoutModal.astro';
import { fetchProductById } from '../../lib/api';

export function getStaticPaths() {
  return [{ params: { id: '1' } }, { params: { id: '2' } }];
}

const { id } = Astro.params;
const fallbackProducts: Record<string, any> = {
  '1': {
    id: '1',
    title: 'Sci-Fi Character Pack',
    description: 'Collection of futuristic character models with full rigging and animations for game development. Perfect for sci-fi games and projects.',
    category: 'Characters',
    individualPrice: 15.00,
    indieTeamPrice: 25.00,
    aaaStudioPrice: 50.00,
    currency: 'USD',
    r2ModelUrl: 'https://example.com/models/sci-fi-character-pack.glb',
    r2ModelKey: 'sci-fi-character-pack.glb',
    formats: ['blend', 'fbx', 'obj'],
    features: [
      '5 fully rigged character models',
      'Animation-ready with IK/FK setup',
      '4K PBR textures',
      'Optimized for real-time rendering',
      'Multiple LODs included'
    ],
    createdAt: '2024-01-15'
  },
  '2': {
    id: '2',
    title: 'Urban Environment Set',
    description: 'Modular city buildings and street props for creating realistic urban environments. Includes various architectural styles.',
    category: 'Environment',
    individualPrice: 20.00,
    indieTeamPrice: 35.00,
    aaaStudioPrice: 60.00,
    currency: 'USD',
    r2ModelUrl: 'https://example.com/models/urban-environment-set.glb',
    r2ModelKey: 'urban-environment-set.glb',
    formats: ['blend', 'fbx', 'obj'],
    features: [
      '20 modular building pieces',
      'Street props and details',
      'Day/night texture variants',
      'Collision meshes included',
      'Unity/Unreal ready'
    ],
    createdAt: '2024-01-10'
  }
};

const productData = (await fetchProductById(id || '1')) || fallbackProducts[id || '1'] || fallbackProducts['1'];
const product = {
  ...productData,
  id: productData?.id ?? id ?? '1',
  title: productData?.title ?? 'Marketplace Asset',
  description: productData?.description ?? 'Product details unavailable.',
  category: productData?.category ?? 'General',
  individualPrice: Number(productData?.individualPrice ?? productData?.individual_price ?? 0),
  indieTeamPrice: Number(productData?.indieTeamPrice ?? productData?.indie_team_price ?? 0),
  aaaStudioPrice: Number(productData?.aaaStudioPrice ?? productData?.aaa_studio_price ?? 0),
  r2ModelUrl: productData?.r2ModelUrl ?? productData?.model_url ?? productData?.sketchfabModelUid ?? productData?.sketchfab_model_uid ?? '',
  r2ModelKey: productData?.r2ModelKey ?? productData?.r2_model_key ?? '',
  createdAt: productData?.createdAt ?? productData?.created_at ?? '2024-01-01',
  formats: productData?.formats ?? ['blend', 'fbx', 'obj'],
  features: productData?.features ?? [
    'Production-ready asset library',
    'Commercial licensing included',
    'Optimized for game engines',
  ],
};
---

<Layout title={`${product.title} - Marketplace`}>
  <div class="min-h-screen">
    <section class="pt-24 pb-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <nav class="mb-8">
          <ol class="flex items-center space-x-2 text-sm">
            <li><a href="/marketplace" class="text-gray-400 hover:text-accent-cyan">Marketplace</a></li>
            <li class="text-gray-600">/</li>
            <li class="text-text-primary">{product.title}</li>
          </ol>
        </nav>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div>
            <div class="mb-4 flex items-center justify-between">
              <span class="pill">Model preview</span>
              <button id="open-fullscreen-viewer" type="button" class="rounded-full border border-slate-700 bg-slate-900/80 px-3 py-1.5 text-xs font-semibold uppercase tracking-[0.18em] text-slate-200 transition hover:border-slate-500">
                Fullscreen
              </button>
            </div>
            <CustomModelViewer 
              modelUrl={product.r2ModelUrl || ''}
              modelUid={product.r2ModelKey || ''}
              title={product.title}
              autostart={false}
              autospin={true}
            />
          </div>

          <div>
            <h1 class="mb-4 text-4xl font-bold text-accent-cyan">{product.title}</h1>
            <p class="mb-6 text-xl text-text-secondary">{product.description}</p>

            <div class="glassmorphism mb-6 rounded-2xl p-6">
              <div class="mb-4 flex items-center justify-between">
                <h3 class="text-lg font-bold">License tiers</h3>
                <span class="rounded-full border border-slate-700 bg-slate-900/80 px-2 py-1 text-[10px] uppercase tracking-[0.18em] text-slate-300">Live pricing</span>
              </div>
              <div id="license-tier-list" class="space-y-3">
                <button type="button" class="license-tier-btn flex w-full items-center justify-between rounded-xl border border-slate-700 bg-slate-950/70 p-3 text-left transition hover:border-slate-500" data-tier="individual" data-price={product.individualPrice}>
                  <div>
                    <div class="font-bold text-white">Individual</div>
                    <div class="text-sm text-slate-300">Personal use, single project</div>
                  </div>
                  <span class="text-xl font-bold text-accent-amber">${product.individualPrice.toFixed(2)}</span>
                </button>
                <button type="button" class="license-tier-btn flex w-full items-center justify-between rounded-xl border border-accent-cyan bg-sky-500/5 p-3 text-left transition hover:border-sky-400" data-tier="indie_team" data-price={product.indieTeamPrice}>
                  <div>
                    <div class="font-bold text-white">Indie Team</div>
                    <div class="text-sm text-slate-300">Small teams, commercial use</div>
                  </div>
                  <span class="text-xl font-bold text-accent-amber">${product.indieTeamPrice.toFixed(2)}</span>
                </button>
                <button type="button" class="license-tier-btn flex w-full items-center justify-between rounded-xl border border-slate-700 bg-slate-950/70 p-3 text-left transition hover:border-slate-500" data-tier="aaa_studio" data-price={product.aaaStudioPrice}>
                  <div>
                    <div class="font-bold text-white">AAA Studio</div>
                    <div class="text-sm text-slate-300">Large studios, unlimited use</div>
                  </div>
                  <span class="text-xl font-bold text-accent-amber">${product.aaaStudioPrice.toFixed(2)}</span>
                </button>
              </div>
            </div>

            <div class="glassmorphism mb-6 rounded-2xl p-6">
              <h3 class="text-lg font-bold mb-4">Features</h3>
              <ul class="space-y-2">
                {product.features.map((feature) => (
                  <li class="flex items-center">
                    <span class="mr-2 text-accent-cyan">✓</span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="glassmorphism mb-6 rounded-2xl p-6">
              <h3 class="text-lg font-bold mb-4">Available Formats</h3>
              <div class="flex flex-wrap gap-2">
                {product.formats.map((format) => (
                  <span class="rounded-full bg-accent-cyan px-3 py-1 text-sm font-semibold uppercase tracking-[0.08em] text-slate-950">{format}</span>
                ))}
              </div>
            </div>

            <button 
              type="button"
              onclick={`window.showCheckoutModal('${product.id}', '${product.title}', 'indie_team', 'glb')`}
              class="w-full rounded-xl bg-gradient-to-r from-sky-400 to-violet-500 px-8 py-4 text-lg font-bold text-slate-950 transition hover:brightness-110"
            >
              Purchase Asset
            </button>
          </div>
        </div>

        <div class="mt-12 glassmorphism rounded-lg p-8">
          <h2 class="mb-6 text-2xl font-bold text-accent-cyan">Technical Details</h2>
          <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
            <div>
              <h3 class="mb-2 font-bold">Category</h3>
              <p class="text-text-secondary">{product.category}</p>
            </div>
            <div>
              <h3 class="mb-2 font-bold">Release Date</h3>
              <p class="text-text-secondary">{product.createdAt}</p>
            </div>
            <div>
              <h3 class="mb-2 font-bold">Polygons</h3>
              <p class="text-text-secondary">Optimized for real-time</p>
            </div>
            <div>
              <h3 class="mb-2 font-bold">Textures</h3>
              <p class="text-text-secondary">4K PBR included</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="glassmorphism py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <p class="text-text-secondary">&copy; 2024 Mescript Labs. All rights reserved.</p>
      </div>
    </footer>

    <CheckoutModal 
      productId={product.id}
      productTitle={product.title}
      individualPrice={product.individualPrice}
      indieTeamPrice={product.indieTeamPrice}
      aaaStudioPrice={product.aaaStudioPrice}
      formats={product.formats}
    />

    <div id="fullscreen-viewer-overlay" data-product-id={product.id} data-product-title={product.title} class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-950/85 p-4 backdrop-blur-sm">
      <div class="w-full max-w-5xl rounded-3xl border border-slate-700 bg-slate-950/95 p-4 shadow-2xl">
        <div class="mb-4 flex items-center justify-between gap-4">
          <div>
            <p class="text-xs uppercase tracking-[0.2em] text-accent-cyan">Preview</p>
            <h3 class="mt-1 text-xl font-bold text-white">{product.title}</h3>
          </div>
          <button id="close-fullscreen-viewer" type="button" class="rounded-full border border-slate-700 bg-slate-900/80 px-3 py-1.5 text-sm text-slate-200 hover:border-slate-500">Close</button>
        </div>

        <div class="grid gap-6 lg:grid-cols-[1.5fr_0.9fr]">
          <div class="overflow-hidden rounded-2xl border border-slate-700 bg-slate-900/60">
            <div class="h-[440px]">
              <CustomModelViewer 
                modelUrl={product.r2ModelUrl || ''}
                modelUid={product.r2ModelKey || ''}
                title={product.title}
                autostart={false}
                autospin={true}
              />
            </div>
          </div>

          <div class="rounded-2xl border border-slate-700 bg-slate-900/60 p-5">
            <p class="mb-3 text-xs uppercase tracking-[0.2em] text-accent-cyan">Selected tier</p>
            <div class="mb-4 flex items-center justify-between rounded-xl border border-slate-700 bg-slate-950/80 p-3">
              <span id="fullscreen-license-label" class="font-semibold text-white">Indie Team</span>
              <span id="fullscreen-license-price" class="text-xl font-bold text-accent-amber">${product.indieTeamPrice.toFixed(2)}</span>
            </div>

            <div class="space-y-2">
              <button type="button" class="fullscreen-license-option flex w-full items-center justify-between rounded-xl border border-slate-700 bg-slate-950/80 p-3 text-left transition hover:border-slate-500" data-tier="individual" data-price={product.individualPrice}>
                <span class="font-medium text-white">Individual</span>
                <span class="text-sm font-bold text-accent-amber">${product.individualPrice.toFixed(2)}</span>
              </button>
              <button type="button" class="fullscreen-license-option flex w-full items-center justify-between rounded-xl border border-accent-cyan bg-sky-500/5 p-3 text-left transition hover:border-sky-400" data-tier="indie_team" data-price={product.indieTeamPrice}>
                <span class="font-medium text-white">Indie Team</span>
                <span class="text-sm font-bold text-accent-amber">${product.indieTeamPrice.toFixed(2)}</span>
              </button>
              <button type="button" class="fullscreen-license-option flex w-full items-center justify-between rounded-xl border border-slate-700 bg-slate-950/80 p-3 text-left transition hover:border-slate-500" data-tier="aaa_studio" data-price={product.aaaStudioPrice}>
                <span class="font-medium text-white">AAA Studio</span>
                <span class="text-sm font-bold text-accent-amber">${product.aaaStudioPrice.toFixed(2)}</span>
              </button>
            </div>

            <div class="mt-5 flex gap-2">
              <button id="fullscreen-buy" type="button" class="flex-1 rounded-xl bg-gradient-to-r from-sky-400 to-violet-500 px-4 py-3 font-bold text-slate-950 transition hover:brightness-110">
                Proceed
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const fullscreenOverlay = document.getElementById('fullscreen-viewer-overlay');
  const productId = fullscreenOverlay?.dataset?.productId || '';
  const productTitle = fullscreenOverlay?.dataset?.productTitle || '';
  const tierLabels = {
    individual: 'Individual',
    indie_team: 'Indie Team',
    aaa_studio: 'AAA Studio',
  };

  const openFullscreenButton = document.getElementById('open-fullscreen-viewer');
  const closeFullscreenButton = document.getElementById('close-fullscreen-viewer');
  const fullscreenLicenseLabel = document.getElementById('fullscreen-license-label');
  const fullscreenLicensePrice = document.getElementById('fullscreen-license-price');
  const fullscreenBuyButton = document.getElementById('fullscreen-buy');
  const fullscreenOptions = document.querySelectorAll('.fullscreen-license-option');

  let selectedTier = 'indie_team';

  const syncFullscreenTier = (nextTier) => {
    selectedTier = nextTier;
    const selectedOption = document.querySelector(`.fullscreen-license-option[data-tier="${nextTier}"]`);
    const nextPrice = Number(selectedOption?.dataset?.price ?? 0);
    const label = tierLabels[nextTier] || 'Individual';

    if (fullscreenLicenseLabel) fullscreenLicenseLabel.textContent = label;
    if (fullscreenLicensePrice) fullscreenLicensePrice.textContent = `$${Number(nextPrice).toFixed(2)}`;

    fullscreenOptions.forEach((option) => {
      const isSelected = option.dataset.tier === nextTier;
      option.classList.toggle('border-accent-cyan', isSelected);
      option.classList.toggle('bg-sky-500/5', isSelected);
      option.classList.toggle('border-slate-700', !isSelected);
      option.classList.toggle('bg-slate-950/80', !isSelected);
    });
  };

  if (openFullscreenButton && fullscreenOverlay) {
    openFullscreenButton.addEventListener('click', () => {
      fullscreenOverlay.classList.remove('hidden');
      fullscreenOverlay.classList.add('flex');
    });
  }

  if (closeFullscreenButton && fullscreenOverlay) {
    closeFullscreenButton.addEventListener('click', () => {
      fullscreenOverlay.classList.add('hidden');
      fullscreenOverlay.classList.remove('flex');
    });
  }

  fullscreenOptions.forEach((option) => {
    option.addEventListener('click', () => {
      syncFullscreenTier(option.dataset.tier);
    });
  });

  if (fullscreenBuyButton) {
    fullscreenBuyButton.addEventListener('click', () => {
      const format = 'glb';
      window.showCheckoutModal(productId, productTitle, selectedTier, format);
      if (fullscreenOverlay) {
        fullscreenOverlay.classList.add('hidden');
        fullscreenOverlay.classList.remove('flex');
      }
    });
  }

  syncFullscreenTier(selectedTier);
</script>
