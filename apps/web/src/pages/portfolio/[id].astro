---
import Layout from '../../layouts/Layout.astro';
import YouTubeEmbed from '../../components/YouTubeEmbed.astro';

export function getStaticPaths() {
  return [{ params: { id: '1' } }, { params: { id: '2' } }];
}

const { id } = Astro.params;

// Mock portfolio item data - in production this would come from Supabase
const portfolioItems: Record<string, any> = {
  '1': {
    id: '1',
    title: 'Sci-Fi Character Pack',
    description: 'Collection of futuristic character models with full rigging and animations for game development.',
    category: 'Characters',
    tags: ['Sci-Fi', 'Characters', 'Game Ready'],
    videoId: 'dQw4w9WgXcQ',
    createdAt: '2024-01-15',
    stats: {
      polygons: '12,500',
      textures: '4K PBR',
      formats: ['Blend', 'FBX', 'OBJ']
    }
  },
  '2': {
    id: '2',
    title: 'Urban Environment Set',
    description: 'Modular city buildings and street props for creating realistic urban environments.',
    category: 'Environment',
    tags: ['Urban', 'Environment', 'Modular'],
    videoId: 'dQw4w9WgXcQ',
    createdAt: '2024-01-10',
    stats: {
      polygons: '45,000',
      textures: '4K PBR',
      formats: ['Blend', 'FBX', 'OBJ']
    }
  }
};

const item = portfolioItems[id] || portfolioItems['1'];
---

<Layout title={`${item.title} - Portfolio`}>
  <div class="min-h-screen">
    <!-- Navigation -->
    <nav class="glassmorphism fixed top-0 left-0 right-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="text-2xl font-bold text-accent-cyan">Mescript Labs</a>
          </div>
          <div class="hidden md:block">
            <div class="ml-10 flex items-baseline space-x-4">
              <a href="/" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Home</a>
              <a href="/about" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">About</a>
              <a href="/portfolio" class="text-white hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Portfolio</a>
              <a href="/marketplace" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Marketplace</a>
              <a href="/sponsorships" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Sponsorships</a>
              <a href="/contact" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Contact</a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Portfolio Detail Section -->
    <section class="pt-24 pb-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <!-- Breadcrumb -->
        <nav class="mb-8">
          <ol class="flex items-center space-x-2 text-sm">
            <li><a href="/portfolio" class="text-gray-400 hover:text-accent-cyan">Portfolio</a></li>
            <li class="text-gray-600">/</li>
            <li class="text-text-primary">{item.title}</li>
          </ol>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <!-- Video/Preview -->
          <div>
            <YouTubeEmbed videoId={item.videoId} title={item.title} />
          </div>

          <!-- Details -->
          <div>
            <h1 class="text-4xl font-bold mb-4 text-accent-cyan">{item.title}</h1>
            <p class="text-xl text-text-secondary mb-6">{item.description}</p>
            
            <div class="flex flex-wrap gap-2 mb-6">
              {item.tags.map(tag => (
                <span class="bg-accent-cyan text-black text-xs px-2 py-1 rounded">{tag}</span>
              ))}
            </div>

            <div class="glassmorphism rounded-lg p-6 mb-6">
              <h3 class="text-lg font-bold mb-4">Technical Specifications</h3>
              <div class="space-y-2">
                <div class="flex justify-between">
                  <span class="text-text-secondary">Category:</span>
                  <span>{item.category}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-text-secondary">Polygons:</span>
                  <span>{item.stats.polygons}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-text-secondary">Textures:</span>
                  <span>{item.stats.textures}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-text-secondary">Formats:</span>
                  <span>{item.stats.formats.join(', ')}</span>
                </div>
                <div class="flex justify-between">
                  <span class="text-text-secondary">Created:</span>
                  <span>{item.createdAt}</span>
                </div>
              </div>
            </div>

            <div class="flex space-x-4">
              <a href="/marketplace" class="bg-accent-cyan hover:bg-cyan-400 text-black font-bold py-3 px-8 rounded-lg transition">
                View in Marketplace
              </a>
              <a href="/contact" class="glassmorphism hover:bg-card text-white font-bold py-3 px-8 rounded-lg transition">
                Contact Us
              </a>
            </div>
          </div>
        </div>

        <!-- Related Items -->
        <div class="mt-12">
          <h2 class="text-2xl font-bold mb-6 text-accent-cyan">Related Projects</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="glassmorphism rounded-lg p-4">
              <div class="h-32 bg-gradient-to-br from-gray-800 to-gray-900 rounded mb-4 flex items-center justify-center">
                <span class="text-4xl">🏢</span>
              </div>
              <h3 class="font-bold mb-2">Urban Environment Set</h3>
              <a href="/portfolio/2" class="text-accent-cyan hover:underline text-sm">View Details</a>
            </div>
            <div class="glassmorphism rounded-lg p-4">
              <div class="h-32 bg-gradient-to-br from-gray-800 to-gray-900 rounded mb-4 flex items-center justify-center">
                <span class="text-4xl">🌲</span>
              </div>
              <h3 class="font-bold mb-2">Nature Environment Pack</h3>
              <a href="/portfolio" class="text-accent-cyan hover:underline text-sm">View Details</a>
            </div>
            <div class="glassmorphism rounded-lg p-4">
              <div class="h-32 bg-gradient-to-br from-gray-800 to-gray-900 rounded mb-4 flex items-center justify-center">
                <span class="text-4xl">⚔️</span>
              </div>
              <h3 class="font-bold mb-2">Medieval Weapons Pack</h3>
              <a href="/portfolio" class="text-accent-cyan hover:underline text-sm">View Details</a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="glassmorphism py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <p class="text-text-secondary">&copy; 2024 Mescript Labs. All rights reserved.</p>
      </div>
    </footer>
  </div>
</Layout>
