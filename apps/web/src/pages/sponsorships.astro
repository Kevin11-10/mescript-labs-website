---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Sponsorships - Mescript Labs">
  <div class="min-h-screen">
    <!-- Navigation -->
    <nav class="glassmorphism fixed top-0 left-0 right-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="text-2xl font-bold text-accent-cyan">Mescript Labs</a>
          </div>
          <div class="hidden md:block">
            <div class="ml-10 flex items-baseline space-x-4">
              <a href="/" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Home</a>
              <a href="/about" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">About</a>
              <a href="/portfolio" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Portfolio</a>
              <a href="/marketplace" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Marketplace</a>
              <a href="/sponsorships" class="text-white hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Sponsorships</a>
              <a href="/contact" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Contact</a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Sponsorships Section -->
    <section class="pt-24 pb-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-bold mb-4 text-accent-cyan">Sponsorship Goals</h1>
        <p class="text-xl text-text-secondary mb-8 max-w-2xl">
          Support our development and help us create more high-quality 3D assets for the community.
        </p>

        <!-- Sponsorship Goals Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <!-- Goal 1 -->
          <div class="glassmorphism rounded-lg p-6">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Next Asset Pack</h3>
              <span class="bg-accent-cyan text-black text-xs px-2 py-1 rounded">Active</span>
            </div>
            <p class="text-text-secondary mb-4">
              Help us fund the development of our next premium asset pack featuring medieval fantasy environments.
            </p>
            <div class="mb-4">
              <div class="flex justify-between text-sm mb-2">
                <span>Progress</span>
                <span>$2,500 / $5,000</span>
              </div>
              <div class="w-full bg-gray-700 rounded-full h-2">
                <div class="bg-accent-cyan h-2 rounded-full" style="width: 50%"></div>
              </div>
            </div>
            <button class="w-full bg-accent-cyan hover:bg-cyan-400 text-black font-bold py-2 px-4 rounded-md transition">
              Sponsor This Goal
            </button>
          </div>

          <!-- Goal 2 -->
          <div class="glassmorphism rounded-lg p-6">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Tool Development</h3>
              <span class="bg-accent-cyan text-black text-xs px-2 py-1 rounded">Active</span>
            </div>
            <p class="text-text-secondary mb-4">
              Support the development of free tools and plugins for the 3D game development community.
            </p>
            <div class="mb-4">
              <div class="flex justify-between text-sm mb-2">
                <span>Progress</span>
                <span>$1,200 / $3,000</span>
              </div>
              <div class="w-full bg-gray-700 rounded-full h-2">
                <div class="bg-accent-cyan h-2 rounded-full" style="width: 40%"></div>
              </div>
            </div>
            <button class="w-full bg-accent-cyan hover:bg-cyan-400 text-black font-bold py-2 px-4 rounded-md transition">
              Sponsor This Goal
            </button>
          </div>

          <!-- Goal 3 -->
          <div class="glassmorphism rounded-lg p-6">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Community Tutorials</h3>
              <span class="bg-accent-cyan text-black text-xs px-2 py-1 rounded">Active</span>
            </div>
            <p class="text-text-secondary mb-4">
              Fund the creation of free tutorials and educational content for aspiring 3D artists.
            </p>
            <div class="mb-4">
              <div class="flex justify-between text-sm mb-2">
                <span>Progress</span>
                <span>$800 / $2,000</span>
              </div>
              <div class="w-full bg-gray-700 rounded-full h-2">
                <div class="bg-accent-cyan h-2 rounded-full" style="width: 40%"></div>
              </div>
            </div>
            <button class="w-full bg-accent-cyan hover:bg-cyan-400 text-black font-bold py-2 px-4 rounded-md transition">
              Sponsor This Goal
            </button>
          </div>

          <!-- Goal 4 -->
          <div class="glassmorphism rounded-lg p-6">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-xl font-bold">Open Source Assets</h3>
              <span class="bg-green-500 text-black text-xs px-2 py-1 rounded">Completed</span>
            </div>
            <p class="text-text-secondary mb-4">
              Create a collection of free, open-source 3D assets available to everyone.
            </p>
            <div class="mb-4">
              <div class="flex justify-between text-sm mb-2">
                <span>Progress</span>
                <span>$1,500 / $1,500</span>
              </div>
              <div class="w-full bg-gray-700 rounded-full h-2">
                <div class="bg-green-500 h-2 rounded-full" style="width: 100%"></div>
              </div>
            </div>
            <button class="w-full bg-gray-700 text-white font-bold py-2 px-4 rounded-md transition cursor-not-allowed" disabled>
              Goal Completed
            </button>
          </div>
        </div>

        <!-- Sponsorship Tiers -->
        <div class="glassmorphism rounded-lg p-8 mb-8">
          <h2 class="text-2xl font-bold mb-6 text-accent-cyan">Sponsorship Tiers</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="border border-gray-700 rounded-lg p-6">
              <h3 class="text-xl font-bold mb-2">Bronze</h3>
              <p class="text-3xl font-bold text-accent-amber mb-4">$5/month</p>
              <ul class="space-y-2 text-text-secondary">
                <li>• Name on sponsors page</li>
                <li>• Early access to updates</li>
                <li>• Discord supporter role</li>
              </ul>
            </div>
            <div class="border border-accent-cyan rounded-lg p-6 bg-accent-cyan/10">
              <h3 class="text-xl font-bold mb-2">Silver</h3>
              <p class="text-3xl font-bold text-accent-amber mb-4">$15/month</p>
              <ul class="space-y-2 text-text-secondary">
                <li>• All Bronze benefits</li>
                <li>• Monthly Q&A sessions</li>
                <li>• Voting on new assets</li>
                <li>• Exclusive discounts</li>
              </ul>
            </div>
            <div class="border border-gray-700 rounded-lg p-6">
              <h3 class="text-xl font-bold mb-2">Gold</h3>
              <p class="text-3xl font-bold text-accent-amber mb-4">$50/month</p>
              <ul class="space-y-2 text-text-secondary">
                <li>• All Silver benefits</li>
                <li>• Custom asset requests</li>
                <li>• Commercial license</li>
                <li>• Priority support</li>
              </ul>
            </div>
          </div>
        </div>

        <!-- How It Works -->
        <div class="glassmorphism rounded-lg p-8">
          <h2 class="text-2xl font-bold mb-6 text-accent-cyan">How Sponsorship Works</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="text-center">
              <div class="text-4xl mb-4">1️⃣</div>
              <h3 class="text-xl font-bold mb-2">Choose a Goal</h3>
              <p class="text-text-secondary">Select a sponsorship goal that aligns with your interests.</p>
            </div>
            <div class="text-center">
              <div class="text-4xl mb-4">2️⃣</div>
              <h3 class="text-xl font-bold mb-2">Make a Contribution</h3>
              <p class="text-text-secondary">Contribute any amount to help us reach the funding target.</p>
            </div>
            <div class="text-center">
              <div class="text-4xl mb-4">3️⃣</div>
              <h3 class="text-xl font-bold mb-2">Track Progress</h3>
              <p class="text-text-secondary">Watch the progress bar and receive updates as we achieve goals.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="glassmorphism py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <p class="text-text-secondary">&copy; 2024 Mescript Labs. All rights reserved.</p>
      </div>
    </footer>
  </div>
</Layout>
