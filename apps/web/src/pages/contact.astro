---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact - Mescript Labs">
  <div class="min-h-screen">
    <!-- Navigation -->
    <nav class="glassmorphism fixed top-0 left-0 right-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center">
            <a href="/" class="text-2xl font-bold text-accent-cyan">Mescript Labs</a>
          </div>
          <div class="hidden md:block">
            <div class="ml-10 flex items-baseline space-x-4">
              <a href="/" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Home</a>
              <a href="/about" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">About</a>
              <a href="/portfolio" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Portfolio</a>
              <a href="/marketplace" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Marketplace</a>
              <a href="/sponsorships" class="text-gray-300 hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Sponsorships</a>
              <a href="/contact" class="text-white hover:text-accent-cyan px-3 py-2 rounded-md text-sm font-medium">Contact</a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Contact Section -->
    <section class="pt-24 pb-12 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl sm:text-5xl font-bold mb-8 text-accent-cyan">Contact Us</h1>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <!-- Contact Form -->
          <div class="glassmorphism rounded-lg p-8">
            <h2 class="text-2xl font-bold mb-6">Send us a message</h2>
            <form id="contact-form" class="space-y-4">
              <div>
                <label class="block text-sm font-medium mb-2">Name</label>
                <input 
                  type="text" 
                  name="name" 
                  required
                  class="w-full bg-background border border-gray-700 rounded-md p-3 text-text-primary focus:border-accent-cyan focus:outline-none"
                  placeholder="Your name"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium mb-2">Email</label>
                <input 
                  type="email" 
                  name="email" 
                  required
                  class="w-full bg-background border border-gray-700 rounded-md p-3 text-text-primary focus:border-accent-cyan focus:outline-none"
                  placeholder="your@email.com"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium mb-2">Subject</label>
                <input 
                  type="text" 
                  name="subject" 
                  required
                  class="w-full bg-background border border-gray-700 rounded-md p-3 text-text-primary focus:border-accent-cyan focus:outline-none"
                  placeholder="How can we help?"
                />
              </div>
              
              <div>
                <label class="block text-sm font-medium mb-2">Message</label>
                <textarea 
                  name="message" 
                  rows="5" 
                  required
                  class="w-full bg-background border border-gray-700 rounded-md p-3 text-text-primary focus:border-accent-cyan focus:outline-none"
                  placeholder="Your message..."
                ></textarea>
              </div>
              
              <button 
                type="submit"
                class="w-full bg-accent-cyan hover:bg-cyan-400 text-black font-bold py-3 px-4 rounded-md transition"
              >
                Send Message
              </button>
            </form>
          </div>

          <!-- Contact Info -->
          <div class="space-y-6">
            <div class="glassmorphism rounded-lg p-6">
              <h3 class="text-xl font-bold mb-4 text-accent-cyan">Business Inquiries</h3>
              <p class="text-text-secondary mb-2">
                For licensing, partnerships, and business opportunities.
              </p>
              <a href="mailto:business@mescriptlabs.com" class="text-accent-cyan hover:underline">
                business@mescriptlabs.com
              </a>
            </div>

            <div class="glassmorphism rounded-lg p-6">
              <h3 class="text-xl font-bold mb-4 text-accent-cyan">Support</h3>
              <p class="text-text-secondary mb-2">
                For technical support and asset-related questions.
              </p>
              <a href="mailto:support@mescriptlabs.com" class="text-accent-cyan hover:underline">
                support@mescriptlabs.com
              </a>
            </div>

            <div class="glassmorphism rounded-lg p-6">
              <h3 class="text-xl font-bold mb-4 text-accent-cyan">Social Media</h3>
              <div class="flex space-x-4">
                <a href="#" class="text-text-secondary hover:text-accent-cyan transition">
                  Twitter
                </a>
                <a href="#" class="text-text-secondary hover:text-accent-cyan transition">
                  LinkedIn
                </a>
                <a href="#" class="text-text-secondary hover:text-accent-cyan transition">
                  ArtStation
                </a>
              </div>
            </div>

            <div class="glassmorphism rounded-lg p-6">
              <h3 class="text-xl font-bold mb-4 text-accent-cyan">Response Time</h3>
              <p class="text-text-secondary">
                We typically respond to inquiries within 24-48 hours during business days.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="glassmorphism py-8 px-4 sm:px-6 lg:px-8">
      <div class="max-w-7xl mx-auto text-center">
        <p class="text-text-secondary">&copy; 2024 Mescript Labs. All rights reserved.</p>
      </div>
    </footer>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      
      // In production, this would send to your backend
      console.log('Form submitted:', data);
      
      // Show success message
      alert('Thank you for your message! We will get back to you soon.');
      form.reset();
    });
  </script>
</Layout>
