# Environment variables for local development
# Copy this file to .dev.vars and fill in your actual values

# Required
CREEM_API_KEY=your_creem_api_key_here
CREEM_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_TOKEN=your_github_token_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Hugging Face (private dataset - 100GB limit)
HF_TOKEN=your_huggingface_token_here
HF_DATASET_REPO=your_username/your_dataset_name
HF_ACCESS_LEVEL=private # Private dataset with 100GB limit, full access control

# Optional - AI services
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional - GitHub automation
GITHUB_WRITE_TOKEN=your_github_write_token_here
GITHUB_REPO_OWNER=your_github_username
GITHUB_REPO_NAME=your_repo_name
GITHUB_DEFAULT_BRANCH=main
