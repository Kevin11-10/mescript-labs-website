# Creem (active keys used by the worker)
# Set one of these depending on the mode you are testing.
CREEM_API_KEY=your_creem_api_key_here
CREEM_WEBHOOK_SECRET=your_creem_webhook_secret_here

# Optional: keep the mode-specific keys for switching environments later.
# CREEM_API_KEY_SANDBOX=creem_test_5Mghx9m0Owg8LlZX49729y
# CREEM_API_KEY_LIVE=creem_4qLuecRjmmg6yyHE4IuvhN
# CREEM_WEBHOOK_SECRET_SANDBOX=your_sandbox_webhook_secret
# CREEM_WEBHOOK_SECRET_LIVE=your_live_webhook_secret

# GitHub access: read access for private asset downloads and write access for admin content changes
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_WRITE_TOKEN=your_github_repo_write_token_with_contents_write
GITHUB_ASSET_REPO=MescriptLabs/private-assets
GITHUB_REPO_OWNER=MescriptLabs
GITHUB_REPO_NAME=mescript-labs.com
GITHUB_DEFAULT_BRANCH=main
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPASTE_YOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# AI / content automation
# Preferred architecture: backend proxies to a Hugging Face Space AI service, then falls back to OpenAI/Anthropic if configured.
AI_SERVICE_URL=https://your-mescript-ai-space.hf.space
AI_SERVICE_API_KEY=your_hf_space_token_if_required
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
AI_MODEL=gpt-4.1-mini
AI_ADMIN_APPROVAL_REQUIRED=true
ALLOW_AI_OPS=true

# Hugging Face inference (simple model fallback for testing)
HUGGINGFACE_API_KEY=your_huggingface_api_key
HUGGINGFACE_MODEL=gpt2

# Admin auth / content management control
ADMIN_SESSION_SECRET=replace_with_a_long_random_secret
ADMIN_JWT_SECRET=replace_with_a_long_random_secret
ADMIN_EMAIL=admin@mescriptlabs.com

# Cloudflare R2 / self-hosted 3D assets
R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=mescript-models
R2_PUBLIC_URL=https://your-public-bucket-url.r2.dev
MODEL_VIEWER_BASE_URL=https://app.mescriptlabs.workers.dev/3d

# Optional external integrations
IMGBB_API_KEY=your_imgbb_api_key

# Notes:
# - The GitHub write token should include repository contents write permission for automated PRs or direct content edits.
# - For admin-driven source edits, prefer a fine-grained PAT or GitHub App with repo access rather than a broad classic token.
# - Never commit this file with real secrets; use a local .dev.vars file instead.
