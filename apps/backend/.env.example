# Required for production (set in Render dashboard)
CREEM_API_KEY=your_creem_api_key
CREEM_WEBHOOK_SECRET=your_webhook_secret
GITHUB_TOKEN=your_github_token
GITHUB_ASSET_REPO=MescriptLabs/private-assets
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
HF_TOKEN=your_huggingface_token
HF_DATASET_REPO=your_username/your_dataset_name
HF_ACCESS_LEVEL=private

# Optional
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
GITHUB_WRITE_TOKEN=your_github_write_token
